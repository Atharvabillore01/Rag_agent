```gitignore
# ==========================
# Environment & Secrets
# ==========================
.env
.env.local
.env.*.local
!.env.example

# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Build artifacts
build/
dist/
downloads/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Python caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.hypothesis/
.coverage
htmlcov/

# ==========================
# Node.js / React / Vite
# ==========================
node_modules/
frontend/node_modules/

dist/
frontend/dist/

.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================
# Database
# ==========================
*.db
*.sqlite
*.sqlite3
pgdata/

# ==========================
# Logs
# ==========================
*.log
logs/

# ==========================
# Docker
# ==========================
.docker/
docker-compose.override.yml

# ==========================
# IDE & Editors
# ==========================
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ==========================
# Temporary / Cache
# ==========================
.cache/
.tmp/
tmp/
temp/
*.pid

# ==========================
# Operating System
# ==========================
.DS_Store
Thumbs.db

# ==========================
# Alembic
# ==========================
alembic/versions/__pycache__/

# ==========================
# Optional Generated Files
# ==========================
uploads/

# ==========================
# Markdown
# ==========================
# Remove these lines unless you intentionally want to ignore all Markdown.
# *.md
# !README.md
# !CONTRIBUTING.md
```
