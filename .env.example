# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider: groq | openai | azure_openai | claude | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_ROUTER_MODEL=llama-3.1-8b-instant

# ── Embeddings ────────────────────────────────────────────────────────────────
# Provider: local | ollama | openai
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-large-en-v1.5

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (local GPU) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=rag-documents
S3_REGION=us-east-1
