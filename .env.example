# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Registration (G5 — security) ──────────────────────────────────────────────
# Self-serve /auth/register creates a new tenant + org_admin, so it is OFF by
# default. Set true to allow open sign-up (e.g. local dev), or leave false and
# list permitted email domains to restrict who can register.
ALLOW_OPEN_REGISTRATION=false
# REGISTRATION_ALLOWED_DOMAINS=["yourfirm.com","example.com"]

# NOTE (G1): when DEBUG=false the app refuses to boot on default infra creds
# (minioadmin / rag:rag / empty QDRANT_API_KEY) — set real values below in prod.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider: groq | openai | azure_openai | claude | ollama | gemini | openai_compatible | huggingface
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_ROUTER_MODEL=llama-3.1-8b-instant

# ── Per-task model routing (feature-implementation-plan §5) ───────────────────
# Send each task to the best/cheapest model for it. All optional — leave blank
# and the task uses LLM_PROVIDER/LLM_MODEL (identical to before). An empty MODEL
# with a set PROVIDER uses that provider's default model.
# Recommended (best + cheap):
#   route     -> groq llama-3.1-8b-instant       (fast/cheap classification)
#   extract   -> gemini gemini-2.0-flash  OR  groq llama-3.3-70b  (cheap, strong JSON)
#   draft     -> claude claude-sonnet-5  OR  gemini-1.5-pro  OR  gpt-4o  (strong long-form)
#   vision    -> gemini gemini-2.0-flash  (cheap + accurate OCR of complex docs)
#   translate -> gemini gemini-2.0-flash  OR  a fine-tuned open model via openai_compatible
#   verify    -> a DIFFERENT provider than draft (independence), e.g. gemini if draft=claude
# LLM_EXTRACT_PROVIDER=
# LLM_EXTRACT_MODEL=
# LLM_DRAFT_PROVIDER=
# LLM_DRAFT_MODEL=
# LLM_VISION_PROVIDER=
# LLM_VISION_MODEL=
# LLM_TRANSLATE_PROVIDER=
# LLM_TRANSLATE_MODEL=
# LLM_VERIFY_PROVIDER=
# LLM_VERIFY_MODEL=

# ── Embeddings ────────────────────────────────────────────────────────────────
# Provider: local | ollama | openai
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-large-en-v1.5

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (local GPU) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Gemini (Google) — strong low-cost multimodal; good for vision/translate ──
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI-compatible endpoint ────────────────────────────────────────────────
# One provider for ANY OpenAI-compatible server: Together / Fireworks /
# OpenRouter / DeepInfra / vLLM / LM Studio — and YOUR OWN fine-tuned open model.
# This is how open-source & fine-tuned HF models plug in: host behind an
# OpenAI-compatible endpoint and point a task's provider at "openai_compatible".
#   e.g. Together: https://api.together.xyz/v1 , model meta-llama/Llama-3.3-70B-Instruct-Turbo
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ── Hugging Face Inference (OpenAI-compatible router) ─────────────────────────
HF_API_KEY=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=rag-documents
S3_REGION=us-east-1
